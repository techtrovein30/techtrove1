session_handoff_email_system.txt
# Session handoff notes (context only, not needed to run the site)
HANDOFF_*.txt
# Supabase CLI local state (machine-specific, never commit).
# supabase/migrations/ and supabase/functions/ ARE tracked on purpose.
supabase/.temp/
# Local admin tooling scripts
scripts/
